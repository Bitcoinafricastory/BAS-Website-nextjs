rules_version = '2';

// Bitcoin Africa Story — Cloud Storage security rules.
// Deploy by pasting into Firebase Console → Storage → Rules → Publish,
// or `firebase deploy --only storage`.
//
// Note: images shown on the site are loaded with download-token URLs, which
// work regardless of these rules. These rules control the Firebase SDK:
// who can upload, overwrite, delete, list or fetch download URLs.

service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['smartdestinyonyekachi@gmail.com'];
    }

    // Team members (Dashboard > Team & Access) may upload new images, but
    // never replace or delete existing files. Reads their staff entry from
    // Firestore; Firebase asks to allow this cross-service access when the
    // rules are published.
    function isStaff() {
      return request.auth != null
        && request.auth.token.email != null
        && firestore.exists(/databases/(default)/documents/staff/$(request.auth.token.email.lower()))
        && firestore.get(/databases/(default)/documents/staff/$(request.auth.token.email.lower())).data.get('active', true) == true;
    }

    function isImageUnder(mb) {
      return request.resource != null
        && request.resource.contentType.matches('image/.*')
        && request.resource.size < mb * 1024 * 1024;
    }

    function isPublicSubmissionFolder(folder) {
      return folder in ['submissions', 'submittedEvents'];
    }

    // Public forms (story pitches, event banners): anyone may upload a NEW
    // image. The uploader can fetch its URL for 10 minutes (the form needs
    // that); after that only the admin can.
    match /{folder}/{file} {
      allow create: if isPublicSubmissionFolder(folder)
        && resource == null
        && isImageUnder(10);
      allow get: if isPublicSubmissionFolder(folder)
        && request.time < resource.timeCreated + duration.value(10, 'm');
    }

    // All site media. Public can fetch; the owner uploads, replaces and
    // deletes; team members can add new images. Listing folders is never
    // allowed.
    match /{folder}/{allPaths=**} {
      allow get: if !isPublicSubmissionFolder(folder) || isAdmin() || isStaff();
      allow create: if (isAdmin() || isStaff()) && isImageUnder(15);
      allow update: if isAdmin() && isImageUnder(15);
      allow delete: if isAdmin();
    }
  }
}
